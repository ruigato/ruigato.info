# Optional: point legacy media URLs at a local WordPress mirror (XAMPP).
# No trailing slash. Example: http://127.0.0.1/ruigato.info
# VITE_LEGACY_WP_ORIGIN=

# Optional: filesystem path from which Vite should serve `/wp-content/...`
# and from which `node scripts/export-canonical-works.mjs` should copy
# legacy WordPress assets into `public/media/wp-content/...`.
# Default: C:\xampp\htdocs\ruigato\wp-content
# LEGACY_WP_CONTENT_DIR=

